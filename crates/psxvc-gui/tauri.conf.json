{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PS1 Video Converter",
  "identifier": "com.darkcloudyskies.psxvc",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PS1 Video Converter",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
